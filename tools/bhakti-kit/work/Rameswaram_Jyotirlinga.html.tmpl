<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rāmeśvaram Jyotirliṅga: A Reference Guide · srini.presents</title>
<meta name="description" content="Rāmeśvaram jyotirliṅga: Rāma's worship of Śiva, Sītā's sand liṅga and Hanumān's Viśvaliṅga, the Setupatis' great corridors, the 22 tīrthas, the crystal liṅga, Kāśī–Rāmeśvaram, the Cār Dhām and Rāma Setu, illustrated.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Comic+Neue:wght@400;700&family=Noto+Sans:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#111;
    --paper:#fffaf0;
    --page:#fbe9d7;
    --yellow:#ffd60a;
    --red:#c0392b;
    --saffron:#ff8c1a;
    --blue:#1d6fb8;
    --green:#2a9d6f;
    --purple:#7a3fa0;
    --dot:rgba(0,0,0,.10);
    --c-yellow:#fff3b0;--c-blue:#dcecff;--c-red:#ffe0e0;--c-green:#ddf5ea;--c-purple:#ece0fa;--c-saffron:#ffe3c4;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){--page:#2a1d16;--dot:rgba(255,255,255,.08)}
  }
  :root[data-theme="dark"]{--page:#2a1d16;--dot:rgba(255,255,255,.08)}
  *{box-sizing:border-box}
  html,body{overflow-x:hidden}
  body{
    margin:0;background:var(--page);color:var(--ink);
    font-family:"Comic Neue","Noto Sans","Comic Sans MS",cursive;font-size:16.5px;line-height:1.5;
    background-image:radial-gradient(var(--dot) 1px,transparent 1.4px);background-size:10px 10px;
  }
  .book{max-width:1000px;margin:0 auto;padding:24px 16px 60px}
  h1,h2,h3,h4,.bang{font-family:"Bangers",Impact,sans-serif;letter-spacing:1.2px;font-weight:400;margin:0}
  p{margin:6px 0}
  ul{margin:6px 0;padding-left:20px} li{margin:3px 0}
  i,em{font-family:"Noto Sans",sans-serif;font-style:italic;font-size:.95em}

  .page{background:var(--paper);border:5px solid var(--ink);box-shadow:10px 10px 0 var(--ink);padding:18px;margin:46px 0 30px;position:relative}
  .page-title{display:inline-block;background:var(--yellow);border:4px solid var(--ink);padding:6px 18px;font-size:32px;transform:rotate(-1.2deg);box-shadow:5px 5px 0 var(--ink);margin:-44px 0 14px -6px}
  .sub{font-family:Bangers;font-size:20px;color:var(--red);margin:-4px 0 10px;letter-spacing:1px}

  .panel{border:4px solid var(--ink);background:#fff;padding:12px 14px;position:relative;margin:0 0 12px}
  .halftone{background-image:radial-gradient(rgba(0,0,0,.12) 1.1px,transparent 1.5px);background-size:8px 8px}
  .bg-yellow{background-color:var(--c-yellow)}.bg-blue{background-color:var(--c-blue)}.bg-red{background-color:var(--c-red)}
  .bg-green{background-color:var(--c-green)}.bg-purple{background-color:var(--c-purple)}.bg-saffron{background-color:var(--c-saffron)}
  .panel > h3{font-size:24px;margin-bottom:6px}
  .panel:has(> .burst) > h3{padding-right:130px}

  .g2,.g3,.g4{display:grid;gap:10px;margin:0 0 12px}
  .g2{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}
  @media (max-width:720px){.g2,.g3,.g4{grid-template-columns:1fr}}
  .card{border:3px solid var(--ink);background:#fff;padding:9px 11px;box-shadow:4px 4px 0 var(--ink)}
  .card h4{font-size:19px;margin-bottom:3px}
  .card p{margin:2px 0}

  .caption{display:inline-block;background:var(--yellow);border:3px solid var(--ink);padding:2px 10px;font-weight:700;font-size:13.5px;text-transform:uppercase;margin-bottom:8px}
  .num{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:34px;padding:0 4px;border-radius:17px;background:var(--red);color:#fff;border:3px solid var(--ink);font-family:Bangers;font-size:18px;margin-right:8px;flex:none}

  .bubble{position:relative;background:#fff;border:3px solid var(--ink);border-radius:20px;padding:8px 13px;margin:8px 0 20px}
  .bubble:after{content:"";position:absolute;bottom:-18px;left:30px;border:9px solid transparent;border-top:12px solid var(--ink)}
  .bubble:before{content:"";position:absolute;bottom:-12px;left:33px;border:6px solid transparent;border-top:9px solid #fff;z-index:1}
  .bubble.right:after{left:auto;right:30px}.bubble.right:before{left:auto;right:33px}
  .bubble.lion{background:#ffe3c4}.bubble.lion:before{border-top-color:#ffe3c4}
  .bubble.me{background:#fff3b0}.bubble.me:before{border-top-color:#fff3b0}
  .who{font-family:Bangers;font-size:17px;letter-spacing:1px}

  .burst{position:absolute;font-family:Bangers;color:#fff;background:var(--red);border:3px solid var(--ink);padding:5px 11px;transform:rotate(7deg);top:8px;right:10px;font-size:19px;box-shadow:3px 3px 0 var(--ink);z-index:2;
    clip-path:polygon(0 15%,12% 0,30% 10%,50% 0,70% 10%,88% 0,100% 15%,94% 50%,100% 85%,88% 100%,70% 90%,50% 100%,30% 90%,12% 100%,0 85%,6% 50%)}
  .burst.yel{background:var(--yellow);color:var(--ink)}

  .plain{border:3px dashed var(--ink);background:#fff;padding:8px 12px;margin:0 0 12px;border-radius:10px}
  .plain:before{content:"🧠 IN PLAIN WORDS: ";font-family:Bangers;letter-spacing:1px;color:var(--purple);font-size:17px}
  .key{background:var(--ink);color:#fff;padding:9px 14px;margin:0 0 12px;border:3px solid var(--ink)}
  .key b{color:var(--yellow)}
.key a{color:#8fd3ff;text-decoration:underline}
  .key:before{content:"⚡ TAKEAWAY: ";font-family:Bangers;letter-spacing:1px;color:var(--yellow);font-size:17px}
  .inner{background:var(--c-purple);border-left:6px solid var(--purple);padding:7px 11px;margin:6px 0 10px}
  .inner:before{content:"🪔 INNER TEACHING: ";font-family:Bangers;letter-spacing:1px;color:var(--purple);font-size:17px}
  .note{background:var(--c-blue);border-left:6px solid var(--blue);padding:6px 10px;margin:6px 0 10px;font-size:15px}
  .note:before{content:"📌 NOTE: ";font-weight:700}

  table.ct{border-collapse:collapse;width:100%;background:#fff;margin:0 0 12px;font-size:15px}
  table.ct th,table.ct td{border:3px solid var(--ink);padding:6px 9px;text-align:left;vertical-align:top}
  table.ct th{background:var(--yellow);font-family:Bangers;letter-spacing:1px;font-size:17px;font-weight:400}
  table.ct tr:nth-child(even) td{background:#fff7ef}
  table.ct td.w{font-family:"Noto Sans",sans-serif;font-style:italic;font-weight:700;white-space:nowrap}

  .quiz{border:4px solid var(--ink);background:#4a1f14;color:#fff;padding:12px 14px;margin:0 0 12px}
  .quiz .q{font-weight:700;margin-bottom:6px}
  .quiz .q:before{content:"QUICK CHECK ❓ ";font-family:Bangers;color:var(--yellow);font-size:18px;letter-spacing:1px}
  .quiz ol{list-style:upper-alpha;margin:4px 0;padding-left:24px}
  .quiz li.ok{color:#7dffb5;font-weight:700}
  .quiz li.ok:after{content:"  ✔ CORRECT"}
  .quiz .why{background:#fff;color:var(--ink);padding:5px 9px;margin-top:6px;border-radius:6px}
  .quiz .why b{color:var(--red)}

  .steps{counter-reset:s;display:grid;gap:8px;margin:0 0 12px}
  .steps div{border:3px solid var(--ink);background:#fff;padding:8px 10px 8px 52px;position:relative;min-height:46px}
  .steps div:before{counter-increment:s;content:counter(s);position:absolute;left:8px;top:7px;width:32px;height:32px;border-radius:50%;background:var(--saffron);color:#fff;border:3px solid var(--ink);font-family:Bangers;font-size:19px;display:flex;align-items:center;justify-content:center}

  /* Verse block */
  .sloka{border:5px solid var(--ink);background:var(--c-saffron);margin:22px 0 16px;padding:0 14px 12px;box-shadow:7px 7px 0 var(--red);position:relative}
  .sloka-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 -14px 10px;padding:8px 14px;background:var(--red);color:#fff;border-bottom:4px solid var(--ink)}
  .sloka-head h3{font-size:28px;color:#fff;text-shadow:2px 2px 0 var(--ink)}
  .sloka-head .theme{font-family:Bangers;font-size:19px;letter-spacing:1px;color:var(--yellow);flex:1}
  .date{font-family:Bangers;letter-spacing:1px;background:#fff;color:var(--ink);border:3px solid var(--ink);padding:1px 10px;font-size:16px}
  .iast{font-family:"Noto Sans",sans-serif;font-style:italic;background:#fff;border:3px solid var(--ink);padding:9px 12px;line-height:1.65;font-size:15.5px;margin:0 0 10px}
  .iast:before{content:"🔤 CHANT (TRANSLITERATION)";display:block;font-family:Bangers;font-style:normal;letter-spacing:1px;color:var(--red);font-size:16px;margin-bottom:2px}
  .mean{background:#fff;border:3px solid var(--ink);border-radius:16px;padding:9px 12px;margin:0 0 10px}
  .mean:before{content:"💬 WHAT IT SAYS";display:block;font-family:Bangers;letter-spacing:1px;color:var(--blue);font-size:16px;margin-bottom:2px}
  .vfig{display:flex;gap:12px;align-items:flex-start;margin:0 0 10px}
  .vfig svg{flex:none;background:#fff;border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink)}
  .vfig .mean{flex:1;margin:0}
  @media (max-width:720px){.vfig{flex-direction:column}.vfig svg{align-self:center;max-width:100%;height:auto}}

  .fig{display:block;margin:6px auto;max-width:100%;height:auto}
  .center{text-align:center}

  .cover{text-align:center;background:linear-gradient(135deg,#ffb04d,#c0392b);padding:30px 18px;overflow:hidden}
  .cover h1{font-size:clamp(38px,7vw,76px);color:#fff;-webkit-text-stroke:3px var(--ink);text-shadow:6px 6px 0 var(--ink);line-height:.95}
  .cover .tag{font-family:Bangers;font-size:clamp(18px,3.5vw,26px);color:#fff;text-shadow:2px 2px 0 var(--ink);margin-top:10px}
  .rays{position:absolute;inset:0;background:repeating-conic-gradient(from 0deg at 50% 45%,rgba(255,255,255,.18) 0 8deg,transparent 8deg 16deg);pointer-events:none}
  .cover > *:not(.burst):not(.rays){position:relative}

  .toc{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;list-style:none;padding:0;margin:0}
  @media (max-width:600px){.toc{grid-template-columns:1fr}}
  .toc li{border:3px solid var(--ink);background:#fff;padding:6px 10px;display:flex;align-items:center;font-weight:700;margin:0}
  .toc a{color:inherit;text-decoration:none}
  .toc .part{grid-column:1/-1;background:var(--ink);color:var(--yellow);font-family:Bangers;letter-spacing:1.5px;font-size:20px}
  .gloss{display:grid;grid-template-columns:repeat(2,1fr);gap:6px 14px}
  @media (max-width:720px){.gloss{grid-template-columns:1fr}}
  .gloss div{border-bottom:2px dotted #999;padding:3px 0}
  .gloss b{font-family:"Noto Sans",sans-serif;font-style:italic;color:var(--red)}

  .ch-end{display:flex;align-items:center;gap:10px;margin:18px -18px -18px;padding:10px 16px;background:var(--ink);color:#fff;flex-wrap:wrap}
  .ch-end .lbl{font-family:Bangers;letter-spacing:1.5px;font-size:20px;color:var(--yellow);flex:1}
  .ch-end .lbl:before{content:"■ "}
  .ch-end a{font-family:Bangers;letter-spacing:1px;font-size:18px;color:var(--ink);background:var(--yellow);border:3px solid #fff;padding:4px 14px;text-decoration:none;box-shadow:3px 3px 0 var(--red)}
  .ch-end a:hover{background:#fff}

  @media (max-width:600px){
    .book{padding:16px 16px 40px}
    .page{padding:12px;box-shadow:6px 6px 0 var(--ink)}
    .page-title{font-size:23px}
    .sloka{padding:0 10px 10px}
    .sloka-head{margin:0 -10px 10px;padding:8px 10px}
    table.ct{font-size:13px}
    table.ct th,table.ct td{padding:4px 5px;word-break:break-word}
    table.ct td.w{white-space:normal}
    .panel:has(> .burst) > h3{padding-right:0;margin-top:30px}
    .burst{font-size:15px}
    .ch-end{margin:14px -12px -12px}
  }

  @page{size:A4;margin:10mm 9mm}
  @media print{
    *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
    body{font-size:12.5px}
    .book{max-width:none;padding:0}
    .page{box-shadow:none;margin:14px 0 10px;padding:12px;break-inside:auto}
    .page-title{display:block;width:fit-content;margin:0 0 10px;transform:none;font-size:25px;break-after:avoid}
    .panel,.card,.bubble,.quiz,.plain,.key,.inner,.steps div,.toc li,table.ct tr,.cover,.fig,.iast,.mean,.vfig,.ch-end,.sloka-head{break-inside:avoid}
    .sloka{box-shadow:none}
    .ch-end{margin:12px -12px -12px}
  }

  :root{--skin:#f2c79b;--hair:#151515;--grey:#d9d9d9;--gold:#e0a800}
  .cover{background:linear-gradient(135deg,#ffd166,#e0a800 45%,#c0392b)}
  .byline{font-family:Bangers;letter-spacing:2px;font-size:22px;color:#fff;text-shadow:2px 2px 0 var(--ink);margin:0 0 6px}
  .cast{display:flex;justify-content:center;gap:26px;margin:12px 0 4px}
  .cast figure{margin:0;font-weight:700;color:#fff;text-shadow:1px 1px 0 #000;font-size:15px}
  .cast svg{width:74px;height:74px;display:block;margin:0 auto 4px;background:#fff;border:3px solid var(--ink);border-radius:50%}
  .cast small{font-weight:400}
  .talk{display:grid;gap:6px;margin:0 0 12px}
  .say{display:flex;gap:9px;align-items:flex-start}
  .say.b{flex-direction:row-reverse}
  .say svg.av{width:46px;height:46px;flex:none;background:#fff;border:3px solid var(--ink);border-radius:50%}
  .say .bubble{margin:2px 0;flex:1}
  .say .bubble:after,.say .bubble:before{display:none}
  .say.z .bubble{background:#dcecff}
  .say.b .bubble{background:#ffe0e0}
  .vno{font-family:Bangers;font-size:26px;color:#fff;background:var(--ink);border:3px solid var(--ink);padding:0 10px;margin-right:4px}
  .reading p{margin:0 0 9px;font-size:17px;line-height:1.6}
  .reading p:last-child{margin-bottom:0}
  .contlink{font-family:Bangers;letter-spacing:1px;font-size:19px;color:var(--red)}
  .full{columns:2;column-gap:28px;column-rule:2px dotted #c9a26b;font-family:"Noto Sans",sans-serif;font-style:italic;font-size:16px;line-height:1.6;background:#fff;border:3px solid var(--ink);padding:14px 18px}
  .full .ln{display:block;padding-left:1.4em;text-indent:-1.4em}
  .full .end{white-space:nowrap;font-style:normal;font-weight:700;color:var(--red);font-size:.85em;margin-left:.4em}
  .full .ref{color:#7a5a2a}
  .full p{break-inside:avoid;margin:0 0 14px;padding-bottom:10px;border-bottom:1px dashed #e2cfa8}
  .full p:last-child{border-bottom:0}
  .full .vn{font-family:Bangers;font-style:normal;color:var(--red);letter-spacing:1px;font-size:17px;display:block}
  @media(max-width:720px){.full{columns:1;font-size:16.5px}}
  .follow{border:4px dashed var(--ink);background:#fff;padding:18px;text-align:center;font-size:18px;margin:30px 0 12px}
  .follow b{font-family:Bangers;font-weight:400;font-size:28px;letter-spacing:1.5px;display:block}
  .follow a{font-weight:700;color:var(--blue)}
  .card h4,.ch-end .lbl{font-family:"Comic Neue","Noto Sans",sans-serif;font-weight:700;letter-spacing:0}
  /* v2 fixes: phone chant layout, cover contrast, responsive cover art */
  .iast .cl{display:block;padding-left:1.2em;text-indent:-1.2em}
  .iast.two{column-gap:26px;column-rule:1px dotted #c9a26b}
  @media(min-width:721px){.iast.two{columns:2}}
  .cover h1{color:#ffd60a;-webkit-text-stroke:3px var(--ink);paint-order:stroke fill}
  .cover svg{max-width:100%;height:auto}
  @media(max-width:720px){
    .iast{font-size:15px;line-height:1.55;padding:8px 10px}
    .full{font-size:15px;padding:12px 12px}
    .full .ln{padding-left:1em;text-indent:-1em}
    .cover .burst{position:relative;display:inline-block;top:0;right:0;margin:0 0 10px}
  }
  @media print{
    .iast.two{columns:2;font-size:12px;line-height:1.45}
    section.page{break-before:page}
    section.page.cover{break-before:auto}
    .ch-end{display:none}
    #story svg.fig{width:330px;height:auto}
    .steps{gap:5px}
    .steps div{padding-top:5px;padding-bottom:5px;min-height:0}
    .follow{margin:10px 0 0;padding:8px;font-size:15px}
    .follow b{font-size:22px}
    footer{display:none}
    #end .g4{display:none}
    .reading p{font-size:13.5px;line-height:1.5}
    .full{font-size:11.5px;line-height:1.42;padding:8px 12px}
    .full p{margin:0 0 5px;padding-bottom:4px}
    .full .vn{font-size:13px}
    .contlink{display:none}
    .vfig svg{width:300px;height:auto}
    .mean{font-size:14px}
  }

  /* Śiva theme: navy */
  .cover{background:linear-gradient(135deg,#2c5f9e,#0b2a4a 55%,#04101f)}
  .sloka-head{background:#0b2a4a}
  .sloka{background:#dfe9f6;box-shadow:7px 7px 0 #0b2a4a}
  .sub{color:#1d4f9a}
  .num{background:#0b2a4a}
  .steps div:before{background:#1d4f9a}
  .full .vn,.full .end{color:#1d4f9a}
  .full .ref{color:#5b6f8a}
  .iast:before{color:#1d4f9a}
  .contlink{color:#1d4f9a}

  .cover{background:radial-gradient(circle at 50% 38%,#2c5f9e,#0b2a4a 55%,#04101f)}
  @media print{
    .sloka table.ct td,.sloka table.ct th{padding:2px 8px;font-size:12px}
    .sloka .mean{font-size:12.5px;line-height:1.4}
    .sloka .plain{font-size:12.5px;padding:5px 8px}
    .sloka .vfig svg{width:250px}
    .sloka .iast{margin-bottom:6px}
    #full .f2{break-before:page;margin-top:0}
  }
  .series{display:inline-block;font-family:Bangers;letter-spacing:1.5px;background:#ffd60a;color:#111;border:3px solid #111;padding:2px 12px;font-size:18px;margin:6px 0 2px;box-shadow:3px 3px 0 #111}

  .fact td:first-child{font-weight:700;width:34%;background:#dfe9f6}
  .tl{border-left:5px solid #1d4f9a;margin:6px 0 6px 10px;padding-left:16px}
  .tl div{position:relative;margin:0 0 9px;font-size:15px;line-height:1.45}
  .tl div b.yr{display:inline-block;min-width:74px;font-family:Bangers;font-weight:400;letter-spacing:1px;color:#1d4f9a;font-size:18px}
  .tl div:before{content:"";position:absolute;left:-25px;top:5px;width:12px;height:12px;border-radius:50%;background:#ffd60a;border:2px solid #111}
  .pg-fig{display:block;margin:6px auto 10px;max-width:100%;height:auto;border:3px solid var(--ink);background:#fff}
  .chip{display:inline-block;background:#0b2a4a;color:#ffd60a;font-family:Bangers;letter-spacing:1px;padding:2px 10px;margin:0 6px 6px 0;font-size:15px}
  .small{font-size:13px;opacity:.85}
  @media print{
    .tl div{font-size:12.5px;margin-bottom:5px}
    .reading p{font-size:12.8px}
    .pg-fig{max-height:300px;width:auto}
    .card p{font-size:12.5px}
    table.ct td,table.ct th{padding:3px 7px;font-size:12px}
  }
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="kiran" viewBox="0 0 64 64">
    <rect x="12" y="46" width="40" height="22" rx="10" fill="#1d6fb8" stroke="#151515" stroke-width="2"/>
    <circle cx="32" cy="30" r="15" fill="#f2c79b" stroke="#151515" stroke-width="2"/>
    <path d="M17 26 L20 14 L25 21 L29 11 L33 20 L38 11 L41 21 L46 15 L47 27 Q32 19 17 26Z" fill="#151515" stroke="#151515" stroke-width="1.5"/>
    <circle cx="26.5" cy="31" r="2" fill="#151515"/><circle cx="37.5" cy="31" r="2" fill="#151515"/>
    <path d="M26 37 Q32 42 38 37" stroke="#151515" stroke-width="2" fill="none" stroke-linecap="round"/>
  </symbol><symbol id="guru" viewBox="0 0 64 64">
    <rect x="12" y="46" width="40" height="22" rx="10" fill="#c0392b" stroke="#151515" stroke-width="2"/>
    <circle cx="32" cy="30" r="15" fill="#f2c79b" stroke="#151515" stroke-width="2"/>
    <path d="M17 30 Q16 16 32 15 Q48 16 47 30 Q44 21 32 21 Q20 21 17 30Z" fill="#d9d9d9" stroke="#151515" stroke-width="1.5"/>
    <circle cx="26" cy="30" r="4.5" fill="#fff" stroke="#151515" stroke-width="2"/><circle cx="38" cy="30" r="4.5" fill="#fff" stroke="#151515" stroke-width="2"/>
