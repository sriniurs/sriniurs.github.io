<div class="book">

<section class="page cover">
  <div class="rays"></div>
  <div class="burst yel">12 LIGHTS!</div>
  <p class="byline">Srini presents</p>
  <h1 style="font-size:clamp(26px,7.5vw,76px)">DVĀDAŚA<br>JYOTIRLIṄGA STOTRAM</h1>
